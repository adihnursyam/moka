TURSO_DATABASE_URL=libsql://database-name-organization.turso.io
TURSO_AUTH_TOKEN=replace-with-a-database-token
DRIZZLE_DATABASE_URL=file:.local-migration/local.db
# DRIZZLE_AUTH_TOKEN is required only when DRIZZLE_DATABASE_URL targets Turso.
DRIZZLE_AUTH_TOKEN=

BASE_URL=http://localhost:3000
PAGE_PASSWORD_HASH=replace-with-a-bcrypt-hash
PASSWORD_COOKIE_NAME=hasPageAccess
